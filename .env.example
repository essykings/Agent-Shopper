# Copy to .env and fill in. Never commit .env.
# From developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id PayPal gives the webhook you set up in the developer dashboard (the address must be public https, for example https://your-app.onrender.com/api/paypal/webhook).
# Without it every webhook is refused. Leave it empty until the app is deployed.
PAYPAL_WEBHOOK_ID=
# Email of a SANDBOX BUSINESS account that is NOT the one your app belongs to (a demo shop)
SHOP_PAYEE_EMAIL=
# Optional: printed by the first run, lets later runs skip the buyer approval step
VAULT_ID=

# Partner route probe (a second sandbox app of Type: Platform)
PLATFORM_CLIENT_ID=
PLATFORM_CLIENT_SECRET=
# Optional: App settings > Reports, last line (BN code)
PLATFORM_BN_CODE=
# Optional: merchant ID of the platform's own sandbox business account (needed for "status")
PARTNER_MERCHANT_ID=

# Partner charge test: the shop's merchantIdInPayPal from onboarding (13 characters, not a secret)
SELLER_MERCHANT_ID=
# Optional: printed by the first partner-charge run
PLATFORM_VAULT_ID=

# Local database from docker-compose.yml (a throwaway local password, not a secret)
DATABASE_URL=postgres://shopper:shopper@127.0.0.1:54329/agent_shopper

# Needed only for a real run of the shopper agent (it spends real money on your Anthropic account)
ANTHROPIC_API_KEY=

# ---- The web app (npm run app, or npm run app:mock for no-cost mock mode) ----
# 1 = a scripted shopper and a pretend PayPal. Nothing here costs money. Leave out (or 0) to use the real Claude model and the PayPal sandbox.
MOCK_SERVICES=
# At least 32 random characters. Required when NODE_ENV=production. Without it a temporary one is used and everyone is signed out on every restart.
SESSION_SECRET=
# The address people use. Only needed with a custom domain: on Render it is read from RENDER_EXTERNAL_URL.
PUBLIC_URL=
# The shared sandbox buyer's saved PayPal (the "Try the demo" button). VAULT_ID is used if this is empty.
DEMO_VAULT_ID=
# How many proxies sit in front of the app (0 on your machine). On Render it measured 2 (the visitor, then a Cloudflare address). Set it from what scripts/cloud-check.ts reports; until it is right, every visitor shares one limit.
TRUSTED_PROXY_HOPS=
# Optional. At least 16 characters. Lets scripts/cloud-check.ts ask the deployed app which address it sees. Leave empty to switch the diagnostic off.
DIAG_TOKEN=

# ---- Limits that keep a public demo from being abused (the defaults are shown) ----
# LIMIT_IP_RUNS_PER_DAY=10          shopper runs per address per 24 hours
# LIMIT_USER_RUNS_PER_DAY=20        shopper runs per demo account per 24 hours
# LIMIT_IP_PURCHASES_PER_DAY=5      approvals that buy something, per address per 24 hours
# LIMIT_IP_SIGNUPS_PER_DAY=5        demo accounts per address per 24 hours
# LIMIT_IP_CONNECTS_PER_DAY=10      "connect my own PayPal" attempts per address per 24 hours
# LIMIT_MAX_CONCURRENT=1            shopper runs at the same moment (the whole app, not per person)
# LIMIT_GLOBAL_RUNS_PER_DAY=300     shopper runs in total per 24 hours
# LIMIT_DAILY_BUDGET_USD=5          the most the model may cost per 24 hours, counted before each run starts
# LIMIT_RUN_TOKEN_CAP=250000        most tokens one run may use
# LIMIT_RUN_SECONDS=120             most seconds one shopper run may take (each model call also has its own 60-second limit)
# AGENT_RUNS_ENABLED=true           set to false to stop all shopper runs at once (the kill switch)

# ---- The shops and their control panel ----
# The three demo shops are part of the app, at /shops/northgear, /shops/deal-zone and /shops/trailhead.
# The control panel (price drops, wrong items) is at /control. CONTROL_TOKEN (12+ characters) is its password. It is required to
# have the panel in production (render.yaml generates one); on your machine the panel is open without it.
# CONTROL_TOKEN=
